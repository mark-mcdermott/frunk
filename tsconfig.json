{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*.ts", "**/*.tsx", "**/*.astro"],
	"exclude": ["dist", "legacy", "node_modules"],
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"]
		}
	}
}
