---
/**
 * Pricing — built to the `pricing` mock. **Currently unpublished.**
 *
 * The leading underscore keeps this file out of Astro's route table. It advertised
 * $4 / $9 / $14 a month and a 14-day free trial with no billing integration behind
 * it, and the positioning question that decides those tiers is still open. Rename to
 * `pricing.astro` and uncomment the nav entries in `src/lib/nav.ts` and
 * `src/components/Footer.astro` to bring it back — the page itself needs no changes.
 *
 *
 * Two deliberate departures from the mock, both because the thing behind them does
 * not exist yet:
 *
 * 1. **No monthly/yearly toggle.** The mock shows a segmented control and "Save 20%
 *    with yearly". Yearly pricing is not a settled commercial decision, and a control
 *    that changes nothing is worse than no control. It becomes a small island once
 *    the plan is decided — the prices below already live in one array for that.
 * 2. **CTAs point at /signup, not checkout.** There is no billing integration; the
 *    merch store's Stripe wiring was dropped in Decision 6 and nothing replaced it.
 *
 * Prices are the mock's own. Publishing them is a commercial statement, not just a
 * design one — see the PR that added this page.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MockImage from '../components/MockImage.astro';
import { ArrowRight, Check, Cloud, RefreshCw, Shield, User } from 'lucide-react';

const plans = [
	{
		name: 'Starter',
		blurb: 'The essentials for keeping your important things in one secure place.',
		price: '$4',
		cadence: 'Billed monthly',
		cta: 'Get started',
		featured: false,
		features: [
			'Up to 1 GB of storage',
			'Documents & files',
			'Mobile app access',
			'Basic encryption',
			'Email support'
		]
	},
	{
		name: 'Pro',
		blurb: 'More space, smarter features, and everything you need day to day.',
		price: '$9',
		cadence: 'Billed monthly',
		cta: 'Start free trial',
		featured: true,
		features: [
			'Up to 10 GB of storage',
			'Everything in Starter',
			'Advanced search',
			'Secure sharing',
			'Priority support'
		]
	},
	{
		name: 'Family',
		blurb: 'Share with the people who matter most.',
		price: '$14',
		cadence: 'Billed monthly',
		cta: 'Start free trial',
		featured: false,
		features: [
			'Up to 25 GB of storage',
			'Everything in Pro',
			'Up to 6 members',
			'Shared folders',
			'Family support'
		]
	}
];

const assurances = [
	{
		icon: Shield,
		title: 'Bank-level security',
		body: 'Your data is encrypted end-to-end and never readable by us.'
	},
	{
		icon: Cloud,
		title: 'Always available',
		body: 'Access your stuff anywhere, anytime, on any device.'
	},
	{
		icon: RefreshCw,
		title: 'Seamless sync',
		body: 'Everything stays up to date across all your devices.'
	},
	{
		icon: User,
		title: "You're in control",
		body: 'You decide what to store, share, and keep private.'
	}
];

const faqs = [
	{
		q: 'What is Frunk?',
		a: "Frunk is a home for everything that belongs to your car — documents, receipts, service history, manuals and photos — kept in one place and organized by vehicle."
	},
	{
		q: 'Is my data secure?',
		a: 'Your data is encrypted in transit and at rest, and private documents are never served from a public URL. You decide what to store and what to share.'
	},
	{
		q: 'Can I cancel anytime?',
		a: 'Yes. Plans are billed monthly and you can cancel whenever you like — your data stays exportable.'
	},
	{
		q: 'What happens after my trial ends?',
		a: "You'll be asked to pick a plan. Nothing is deleted while you decide, and you keep everything you added during the trial."
	}
];
---

<BaseLayout
	title="Pricing — Frunk"
	description="One plan. All the essentials. No limits on the things that matter most."
>
	<Header active="Pricing" />

	<main>
		<section class="surface-light">
			<div class="mx-auto max-w-[1400px] px-6 pb-16 pt-16 sm:px-10 lg:px-16 lg:pb-20 lg:pt-20">
				<div class="grid items-center gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
					<div>
						<p class="eyebrow">Pricing</p>
						<h1 class="display dot mt-6 text-[clamp(2.25rem,5vw,3.5rem)]">
							Simple pricing.<br />Everything included
						</h1>
						<p class="mt-8 max-w-sm text-[0.9375rem] leading-relaxed text-text-muted">
							One plan. All the essentials. No limits on the things that matter most.
						</p>
					</div>

					<MockImage label="Frunk / front storage perspective" ratio="16 / 11" />
				</div>
			</div>
		</section>

		<section class="surface-light">
			<div class="mx-auto max-w-[1400px] px-6 pb-16 sm:px-10 lg:px-16 lg:pb-20">
				<h2 class="sr-only">Plans</h2>
				<div class="grid items-start gap-6 lg:grid-cols-3">
					{
						plans.map((plan) => (
							<article
								class:list={[
									'card relative flex flex-col p-8',
									plan.featured && 'border-accent-bright/40 lg:-mt-6 lg:pb-12 lg:pt-12'
								]}
							>
								{plan.featured && (
									<span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-accent px-3 py-1 text-[0.625rem] font-semibold uppercase tracking-[0.12em] text-white">
										Most popular
									</span>
								)}

								<h3 class="display-sm text-2xl">{plan.name}</h3>
								<p class="mt-3 min-h-[3.5rem] text-[0.875rem] leading-relaxed text-text-muted">
									{plan.blurb}
								</p>

								<p class="mt-6 flex items-baseline gap-2">
									<span class="display text-[3rem] leading-none">{plan.price}</span>
									<span class="text-[0.875rem] text-text-muted">/mo</span>
								</p>
								<p class="mt-2 text-[0.8125rem] text-text-faint">{plan.cadence}</p>

								<a
									href="/signup"
									class:list={[
										'mt-6 inline-flex items-center justify-center rounded-full px-6 py-3 text-[0.9375rem] font-semibold transition-colors',
										plan.featured
											? 'btn-primary justify-center'
											: 'border border-border-strong text-text hover:border-text-muted'
									]}
								>
									{plan.cta}
								</a>

								<ul class="mt-8 flex flex-col gap-3 border-t border-border pt-6">
									{plan.features.map((feature) => (
										<li class="flex items-start gap-3 text-[0.875rem] text-text-muted">
											<Check
												className="mt-0.5 size-4 shrink-0 text-accent-bright"
												aria-hidden="true"
											/>
											{feature}
										</li>
									))}
								</ul>
							</article>
						))
					}
				</div>

				<p class="mt-10 flex items-center justify-center gap-2 text-[0.8125rem] text-text-muted">
					<Shield className="size-4 text-accent-bright" aria-hidden="true" />
					14-day free trial. Cancel anytime.
				</p>
			</div>
		</section>

		<section class="surface-light">
			<div class="mx-auto max-w-[1400px] px-6 pb-20 sm:px-10 lg:px-16">
				<h2 class="sr-only">What every plan includes</h2>
				<div
					class="grid gap-px overflow-hidden rounded-[var(--radius-card)] bg-[rgb(255_255_255/0.08)] md:grid-cols-2 lg:grid-cols-4"
				>
					{
						assurances.map((item) => (
							<article class="flex flex-col gap-3 bg-[#0c1019] p-8">
								<item.icon className="size-5 text-accent-bright" aria-hidden="true" />
								<h3 class="text-[0.9375rem] font-semibold text-white">{item.title}</h3>
								<p class="text-[0.8125rem] leading-relaxed text-[rgb(255_255_255/0.64)]">
									{item.body}
								</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<section class="surface-light">
			<div class="mx-auto max-w-[1400px] px-6 pb-24 sm:px-10 lg:px-16 lg:pb-32">
				<div class="grid gap-10 lg:grid-cols-[minmax(0,0.6fr)_minmax(0,1.4fr)]">
					<div>
						<p class="eyebrow">Questions?</p>
						<h2 class="display dot mt-6 text-[clamp(1.75rem,3.5vw,2.25rem)]">
							Frequently<br />asked questions
						</h2>
						<a href="/about" class="link-rule mt-8">
							<span>Visit our Help Center</span>
							<span class="rule"></span>
							<ArrowRight className="size-3.5" aria-hidden="true" />
						</a>
					</div>

					<div class="flex flex-col">
						{
							faqs.map((faq) => (
								<details class="group border-b border-border first:border-t">
									<summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-[0.9375rem] text-text marker:content-none">
										{faq.q}
										<span
											aria-hidden="true"
											class="shrink-0 text-lg leading-none text-text-muted transition-transform group-open:rotate-45"
										>
											+
										</span>
									</summary>
									<p class="pb-5 pr-10 text-[0.875rem] leading-relaxed text-text-muted">{faq.a}</p>
								</details>
							))
						}
					</div>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</BaseLayout>
