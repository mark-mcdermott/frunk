---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { ResetPasswordForm } from '../components/auth/ResetPasswordForm';
import AuthCardSkeleton from '../components/auth/AuthCardSkeleton.astro';

/**
 * `client:only` with a skeleton, for the reason signin.astro gives: a real-looking
 * form React does not own yet wipes whatever was typed before hydration.
 */
---

<BaseLayout title="Choose a new password — Frunk" description="Set a new Frunk password from your reset link.">
	<div class="surface-light flex min-h-svh flex-col">
		<Header />
		<main class="relative flex flex-1 items-center justify-center px-5 py-10 sm:py-16">
			<div
				aria-hidden="true"
				class="pointer-events-none absolute inset-0 bg-[radial-gradient(55%_45%_at_50%_40%,rgb(100_56_204_/_0.13)_0%,transparent_70%)]"
			></div>
			<div class="relative flex w-full justify-center">
				<ResetPasswordForm client:only="react">
					<AuthCardSkeleton slot="fallback" fields={2} label="Loading the form" />
				</ResetPasswordForm>
			</div>
		</main>
	</div>
</BaseLayout>
