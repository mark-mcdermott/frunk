---
/**
 * Marketing header — a floating card, inset from the viewport edges, rounded, with a
 * soft shadow (DESIGN.md §4). It is white in both themes, matching the mock; the
 * app header (flush, dark, icon cluster + avatar) is a separate component built in
 * Phase 4.
 *
 * Active nav is accent text with a small violet dot centred beneath it.
 *
 * The account control is the one part that differs per visitor, so it is an island and
 * the rest of the page stays static HTML.
 */
import { primaryNav } from '../lib/nav';
import { UserNav } from './auth/UserNav';

interface Props {
	active?: string;
}

const { active } = Astro.props;
---

<!-- The extra top padding is the notch: under viewport-fit=cover the page runs beneath the
     status bar (Capacitor, Safari in landscape), so the pill sits below it and the page's
     own ground shows through above. Zero everywhere else. -->
<header class="pointer-events-none sticky top-0 z-50 px-4 pt-[calc(1rem+env(safe-area-inset-top,0px))] sm:px-6 sm:pt-[calc(1.5rem+env(safe-area-inset-top,0px))]">
	<div class="pointer-events-auto mx-auto flex max-w-[1400px] items-center justify-between gap-6 rounded-[20px] bg-white px-6 py-4 shadow-[0_8px_40px_-12px_rgb(11_15_24_/_0.18)] sm:px-8 sm:py-5">
		<a href="/" class="wordmark text-[#0b0f18] text-lg sm:text-xl" aria-label="Frunk, home">
			FRUNK
		</a>

		<nav aria-label="Main" class="hidden items-center gap-8 md:flex lg:gap-10">
			{primaryNav.map((item) => (
				<a
					href={item.href}
					aria-current={active === item.label ? 'page' : undefined}
					class:list={[
						'relative py-1 text-[0.9375rem] transition-colors',
						active === item.label
							? 'text-[#0b0f18]'
							: 'text-[rgb(11_15_24_/_0.72)] hover:text-[#0b0f18]'
					]}
				>
					{item.label}
					{active === item.label && (
						<span
							aria-hidden="true"
							class="absolute -bottom-1.5 left-1/2 size-[5px] -translate-x-1/2 rounded-full bg-accent-bright"
						/>
					)}
				</a>
			))}
		</nav>

		<UserNav client:load />
	</div>
</header>
