---
/**
 * Marketing header — a floating card, inset from the viewport edges, rounded, with a
 * soft shadow (DESIGN.md §4). It is white in both themes, matching the mock; the
 * app header (flush, dark, icon cluster + avatar) is a separate component built in
 * Phase 4.
 *
 * Active nav is accent text with a small violet dot centred beneath it.
 */
import { primaryNav } from '../lib/nav';

interface Props {
	active?: string;
}

const { active } = Astro.props;
---

<header class="pointer-events-none sticky top-0 z-50 px-4 pt-4 sm:px-6 sm:pt-6">
	<div
		class="pointer-events-auto mx-auto flex max-w-[1400px] items-center justify-between gap-6 rounded-[20px] bg-white px-6 py-4 shadow-[0_8px_40px_-12px_rgb(11_15_24_/_0.18)] sm:px-8 sm:py-5"
	>
		<a href="/" class="wordmark text-[#0b0f18] text-lg sm:text-xl" aria-label="Frunk, home"
			>FRUNK</a
		>

		<nav aria-label="Main" class="hidden items-center gap-8 md:flex lg:gap-10">
			{
				primaryNav.map((item) => (
					<a
						href={item.href}
						aria-current={active === item.label ? 'page' : undefined}
						class:list={[
							'relative py-1 text-[0.9375rem] transition-colors',
							active === item.label
								? 'text-[#0b0f18]'
								: 'text-[rgb(11_15_24_/_0.72)] hover:text-[#0b0f18]'
						]}
					>
						{item.label}
						{active === item.label && (
							<span
								aria-hidden="true"
								class="absolute -bottom-1.5 left-1/2 size-[5px] -translate-x-1/2 rounded-full bg-accent-bright"
							/>
						)}
					</a>
				))
			}
		</nav>

		<a
			href="/signup"
			class="inline-flex items-center gap-2 rounded-full bg-[#0c1019] px-5 py-2.5 text-[0.9375rem] font-semibold text-[#fefefe] transition-opacity hover:opacity-88 sm:px-6 sm:py-3"
		>
			Get started
			<span aria-hidden="true" class="text-xs">&#8599;</span>
		</a>
	</div>
</header>
