---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * A studio render served through `astro:assets` (DESIGN.md §6). One PNG source under
 * `src/assets/renders/` at twice the widest slot it fills; the build cuts AVIF and WebP
 * at the given widths, with a JPEG fallback — the renders are opaque, so nothing is
 * lost flattening them. `eager` is for the one above the fold; the rest lazy-load.
 */
interface Props {
	src: ImageMetadata;
	alt: string;
	widths: number[];
	sizes: string;
	eager?: boolean;
	class?: string;
}

const { src, alt, widths, sizes, eager = false, class: className = '' } = Astro.props;
---

<Picture
	src={src}
	alt={alt}
	widths={widths}
	sizes={sizes}
	formats={['avif', 'webp']}
	fallbackFormat="jpg"
	loading={eager ? 'eager' : 'lazy'}
	fetchpriority={eager ? 'high' : 'auto'}
	decoding={eager ? 'sync' : 'async'}
	class={`h-auto w-full rounded-[var(--radius-card)] border border-border ${className}`.trim()}
/>
