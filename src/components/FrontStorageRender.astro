---
import Render from './Render.astro';
import render from '../assets/renders/front-storage.png';

/**
 * The render every marketing page leads with: the open front trunk, lit from inside
 * in the accent violet. Its slot is about 700 px wide at the widest layout, so the
 * 1400-px source is exactly the retina size.
 */
interface Props {
	eager?: boolean;
	class?: string;
}

const { eager = false, class: className } = Astro.props;
---

<Render
	src={render}
	alt="A silver car with its front trunk open — a wallet, a key, a coin and a photograph inside, lit in violet"
	widths={[560, 800, 1120, 1400]}
	sizes="(min-width: 1024px) 704px, calc(100vw - 3rem)"
	eager={eager}
	class={className}
/>
