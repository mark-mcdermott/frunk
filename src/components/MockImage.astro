---
/**
 * Placeholder for the studio automotive renders (DESIGN.md §6).
 *
 * The PNG originals live in `frunk-proj/branding/mock/`, outside the repo, and only
 * flattened WebP mocks were committed — so the hero and section photography is not
 * yet available to ship. This stands in with the same aspect ratio and the same
 * violet rim light, so layout, spacing and contrast can be verified now. Swap each
 * usage for an <Image> once the renders land.
 */
interface Props {
	label: string;
	class?: string;
	ratio?: string;
}

const { label, class: className, ratio = '16 / 10' } = Astro.props;
---

<div
	class:list={[
		'relative isolate overflow-hidden rounded-[var(--radius-card)] border border-border bg-surface-raised',
		className
	]}
	style={`aspect-ratio: ${ratio};`}
	role="img"
	aria-label={`Placeholder for ${label}`}
>
	<div
		aria-hidden="true"
		class="absolute inset-0 bg-[radial-gradient(120%_90%_at_50%_120%,rgb(100_56_204_/_0.45)_0%,rgb(100_56_204_/_0.10)_45%,transparent_75%)]"
	></div>
	<div
		aria-hidden="true"
		class="absolute inset-x-[12%] bottom-[18%] h-px bg-[linear-gradient(90deg,transparent,rgb(152_144_248_/_0.9),transparent)]"
	></div>
	<span
		aria-hidden="true"
		class="eyebrow absolute bottom-4 left-4 text-text-faint"
		style="letter-spacing: 0.18em;"
	>
		{label}
	</span>
</div>
